compute_epr = function(fg_theta, gt) {
pairs = base::names(fg_theta); head(pairs)
sp = base::strsplit(pairs, "_to_")
tf = base::vapply(sp, `[`, base::character(1), 1L); head(tf)
tg = base::vapply(sp, `[`, base::character(1), 2L); head(tg)
tf = toupper(tf); head(tf) #%%%%%%%%%%%%%%%%%%%%%%%%%
tg = toupper(tg); head(tg) #%%%%%%%%%%%%%%%%%%%%%%%%%
# 去自环、只保留正权重、限制两端基因都在 ground truth 基因宇宙内
ok = tf != tg & fg_theta > 0 &
tf %in% gt$gt_genes & tg %in% gt$gt_genes; table(ok)
tf = tf[ok]; tg = tg[ok]; fg_theta = fg_theta[ok]
# 再限制调控因子为 ground truth 中的 TF
ok2 = tf %in% gt$tf_gene_set; table(ok2)
tf = tf[ok2]; tg = tg[ok2]; fg_theta = fg_theta[ok2]
# 按权重降序
o = base::order(fg_theta, decreasing = TRUE)
tf = tf[o]; tg = tg[o]; fg_theta = fg_theta[o]
if (base::length(fg_theta) == 0) return(0)
# 取 K = k_ref（含 cutoff 处并列）
K = base::min(base::length(fg_theta), gt$k_ref)
cutoff = fg_theta[K]
sel = fg_theta >= cutoff
selected_edges = base::paste(tf[sel], tg[sel], sep = "->")
early_precision = base::sum(selected_edges %in% gt$true_edge_set) /
base::length(selected_edges)
early_precision / gt$epr_random_precision
}
compute_epr(fg_theta = fg, gt = p$gt)
