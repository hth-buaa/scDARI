# 给定 topn 向量（按数据集顺序，每个数据集一个代表 topn）与 fix，
# 计算 4 个数据集的 EPR 及目标 c。
evaluate_config = function(topn_vec, fix) {
epr_out = stats::setNames(base::numeric(base::length(datasets)), datasets)
for (di in base::seq_along(datasets)) {
ds = datasets[di]; p = prep_all[[ds]]
topn_rep = topn_vec[di]
branch_results = base::lapply(p$branch_index, function(b) {
M = p$M_per_branch[b]
# 若该分支 M 与代表 M 不同，按实际 M 重新 clamp 到合法范围
tn = base::min(topn_rep, M)
# 兜底：若缓存里没有该 topn（理论上不会），即时计算
v = p$topn_cache[[b]][[as.character(tn)]]
if (base::is.null(v)) {
v = precompute_topn_vectors(
p$sorted_branches[[b]]$sl, p$sorted_branches[[b]]$st, tn)
}
rescore_branch_fast(v, fix)
})
fg = integrate_branches(branch_results, p$cell_weights)
epr_out[ds] = compute_epr(fg, p$gt)
}
a = base::mean(epr_out)
b = if (base::all(epr_out > 0)) base::exp(base::mean(base::log(epr_out))) else 0
c = (a + b) / 2
base::list(epr = epr_out, a = a, b = b, c = c)
}
