# 为某个算法生成：在固定总体上的真实标签（1=真实边，0=非真实）与预测分数
# （预测到的边用 Strength，未预测到的边记 0）。
build_scored_universe = function(pred) {
pred_lookup = pred$weight
names(pred_lookup) = paste(pred$Gene1, pred$Gene2, sep = "->")
data.table(
edge   = possible$edge,
label  = as.integer(possible$edge %in% true_edge_set),
score  = as.numeric(ifelse(possible$edge %in% names(pred_lookup),
pred_lookup[possible$edge], 0))
)
}
# 为某个算法生成：在固定总体上的真实标签（1=真实边，0=非真实）与预测分数
# （预测到的边用 Strength，未预测到的边记 0）。
build_scored_universe = function(pred) {
pred_lookup = pred$weight
names(pred_lookup) = paste(pred$Gene1, pred$Gene2, sep = "->")
data.table(
edge   = possible$edge,
label  = as.integer(possible$edge %in% true_edge_set),
score  = as.numeric(ifelse(possible$edge %in% names(pred_lookup),
pred_lookup[possible$edge], 0))
)
}
scored_run1 = lapply(run1, build_scored_universe)
