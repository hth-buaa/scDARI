file.create(file.path("/mnt/i/scDARI_Paper/3-benchmark/6-scDARI/tune-select_best_prediction/progress_test", paste0(job$key, "_", job$fix, ".txt")))
base::list(key = job$key, fix = job$fix,
epr = r$epr, a = r$a, b = r$b, c = r$c)
},
mc.cores = ncores
)
