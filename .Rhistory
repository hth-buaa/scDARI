# 手工计算 PR 曲线，口径与 sklearn.metrics.precision_recall_curve 一致：
# 阈值从高到低（包含最低阈值），逐档累计 TP/FP（同分数整组计入），再在高端补“什么都不预测”的点 (recall=0, precision=1)。
pr_curve = function(label, score) {
total_pos = sum(label)
if (total_pos == 0) return(NULL)          # 没有正例，PR 无定义。
thresholds = sort(unique(score), decreasing = TRUE)
tp = sapply(thresholds, function(t) sum(label[score >= t]))
fp = sapply(thresholds, function(t) sum(1 - label[score >= t]))
precision = tp / (tp + fp)
recall    = tp / total_pos
# 高端补“没有任何边预测为正”的点 (recall=0, precision=1)。
precision = c(1, precision)
recall    = c(0, recall)
return(data.frame(recall = recall, precision = precision))
}
# 梯形法求曲线下面积（曲线按 recall 从小到大）。
trap_auc = function(x, y) {
o = order(x)
x = x[o]; y = y[o]
sum(diff(x) * (head(y, -1) + tail(y, -1)) / 2)
}
calc_auprc = function(label, score) {
pr = pr_curve(label, score)
if (is.null(pr)) return(NA_real_)
trap_auc(pr$recall, pr$precision)
}
AUPRC = sapply(scored_run1, function(d) calc_auprc(d$label, d$score))
AUPRC
