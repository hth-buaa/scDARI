gt = data.table::fread(gt_path)
# 只保留两列，去重、去自环
gt = base::unique(gt[gt$Gene1 != gt$Gene2, c("Gene1", "Gene2")])
gt_genes = base::sort(base::unique(c(gt$Gene1, gt$Gene2)))
G = base::length(gt_genes)
true_edge_set = base::paste(gt$Gene1, gt$Gene2, sep = "->")
k_ref = base::length(true_edge_set)
tf_gene_set = base::unique(gt$Gene1)
n_tf_gt = base::length(tf_gene_set)
# EPR 的随机精度：k_ref / (n_tf_gt * (G-1))
epr_random_precision = k_ref / (n_tf_gt * (G - 1))
base::list(
gt_genes = gt_genes, G = G,
true_edge_set = true_edge_set, k_ref = k_ref,
tf_gene_set = tf_gene_set, n_tf_gt = n_tf_gt,
epr_random_precision = epr_random_precision
)
}
# 1.3 对一个分支，预计算“按 loss 全排序”后的 sl / st 矩阵（与参数无关）
precompute_sorted = function(theta_mat, loss_mat, ncores) {
N = base::nrow(loss_mat); M = base::ncol(loss_mat)
# 每行按 loss 升序，得到全排序的列索引（N×M）
order_full = function(mat) base::t(base::apply(mat, 1, base::order))
if (base::is.numeric(ncores) && ncores > 1 && .Platform$OS.type == "unix") {
n_workers = base::as.integer(base::min(ncores, N))
block_size = base::ceiling(N / n_workers)
chunk_id = ((base::seq_len(N) - 1L) %/% block_size) + 1L
row_chunks = base::split(base::seq_len(N), chunk_id)
order_list = parallel::mclapply(
X = row_chunks,
FUN = function(idx) order_full(loss_mat[idx, , drop = FALSE]),
mc.cores = n_workers
)
# 校验 worker 结果（防止 fork 静默少返回）
if (base::length(order_list) != base::length(row_chunks) ||
base::any(base::vapply(order_list, function(x) !base::is.matrix(x), base::logical(1)))) {
base::stop("并行排序失败：某个 worker 未返回矩阵。")
}
ord = base::do.call(base::rbind, order_list)
if (base::nrow(ord) != N || base::ncol(ord) != M) {
base::stop("并行排序失败：行数不匹配。")
}
} else {
ord = order_full(loss_mat)
}
ri = base::rep(base::seq_len(N), M)
ci = base::as.vector(ord)
sl = base::matrix(loss_mat[base::cbind(ri, ci)], N, M,
dimnames = base::list(base::rownames(loss_mat), NULL))
st = base::matrix(theta_mat[base::cbind(ri, ci)], N, M,
dimnames = base::list(base::rownames(theta_mat), NULL))
base::list(sl = sl, st = st)
}
# 1.4 给定一个分支的 sl / st 与某个 topn，预算 6 个只依赖 topn 的向量
#     （把“边界权重×fix”分离后，每个 fix 只需向量运算）
#     三角权重 w：w=(lmax-l)/(lmax-lmin)；loss 全相等则 w=1。
#     边界 bd：theta<0.0101 或 theta>0.9899。
precompute_topn_vectors = function(sl, st, topn) {
lt = sl[, base::seq_len(topn), drop = FALSE]
tt = st[, base::seq_len(topn), drop = FALSE]
lmin = lt[, 1]; lmax = lt[, topn]; rng = lmax - lmin
w = base::matrix(1, base::nrow(lt), topn)
tied = rng <= 0
if (base::any(!tied)) {
w[!tied, ] = (lmax[!tied] - lt[!tied, ]) / rng[!tied]
}
# 边界掩码（转成 0/1 以便代数运算）
bd = 1 * (tt < 0.0101 | tt > 0.9899)
# 6 个向量：
#   W0 = sum(w)；Wb = sum(w*bd)
#   T0 = sum(theta*w)；Tb = sum(theta*w*bd)
#   L0 = sum(loss*w)；Lb = sum(loss*w*bd)
base::list(
W0 = base::rowSums(w),            Wb = base::rowSums(w * bd),
T0 = base::rowSums(tt * w),       Tb = base::rowSums(tt * w * bd),
L0 = base::rowSums(lt * w),       Lb = base::rowSums(lt * w * bd),
pair_names = base::rownames(sl)
)
}
# 1.5 由 6 个预算向量与 fix，快速得到该分支的 theta_best / loss_best（全量），
#     并按原函数口径做过滤（theta>=0.011 且 loss 有限），返回命名的 best 结果。
#     代数关系：
#       wsum = W0 + (fix-1)*Wb
#       theta = (T0 + (fix-1)*Tb) / wsum
#       loss  = (L0 + (fix-1)*Lb) / wsum
rescore_branch_fast = function(v, fix) {
wsum = v$W0 + (fix - 1) * v$Wb
# 防止总权重为 0（fix=0 且选中模型全为边界时）；此时该边视为无效
safe_wsum = base::ifelse(wsum > 0, wsum, NA_real_)
theta = (v$T0 + (fix - 1) * v$Tb) / safe_wsum
loss  = (v$L0 + (fix - 1) * v$Lb) / safe_wsum
base::names(theta) = v$pair_names
base::names(loss)  = v$pair_names
# 无效权重导致的 NaN/NA 一并过滤
keep = !base::is.na(theta) & theta >= 0.011 & base::is.finite(loss)
base::list(theta = theta[keep], loss = loss[keep])
}
# 1.6 把同一数据集的多个分支 best 结果，按细胞数加权整合（得到 FG.theta_p）
#     忠实复刻原函数：对每个 pair，只在“该分支保留了该 pair”的分支间加权。
integrate_branches = function(branch_results, cell_weights) {
n_branch = base::length(branch_results)
all_pairs = base::sort(base::unique(base::unlist(base::lapply(
branch_results, function(x) base::names(x$theta)
))))
np = base::length(all_pairs)
if (np == 0) return(stats::setNames(base::numeric(0), base::character(0)))
theta_mat = base::matrix(NA_real_, np, n_branch)
for (b in base::seq_len(n_branch)) {
theta_mat[, b] = branch_results[[b]]$theta[all_pairs]
}
mask = !base::is.na(theta_mat)
theta_mat[!mask] = 0
W = base::matrix(cell_weights, np, n_branch, byrow = TRUE)
den = base::rowSums(W * mask)
fg = base::ifelse(
den > 0,
base::rowSums(theta_mat * W * mask) / base::pmax(den, .Machine$double.eps),
0
)
stats::setNames(fg, all_pairs)
}
# 1.7 计算单个数据集的 EPR（忠实复刻评估代码 calc_epr 口径）
compute_epr = function(fg_theta, gt) {
pairs = base::names(fg_theta)
sp = base::strsplit(pairs, "_to_")
tf = base::vapply(sp, `[`, base::character(1), 1L)
tg = base::vapply(sp, `[`, base::character(1), 2L)
# 去自环、只保留正权重、限制两端基因都在 ground truth 基因宇宙内
ok = tf != tg & fg_theta > 0 &
tf %in% gt$gt_genes & tg %in% gt$gt_genes
tf = tf[ok]; tg = tg[ok]; fg_theta = fg_theta[ok]
# 再限制调控因子为 ground truth 中的 TF
ok2 = tf %in% gt$tf_gene_set
tf = tf[ok2]; tg = tg[ok2]; fg_theta = fg_theta[ok2]
# 按权重降序
o = base::order(fg_theta, decreasing = TRUE)
tf = tf[o]; tg = tg[o]; fg_theta = fg_theta[o]
if (base::length(fg_theta) == 0) return(0)
# 取 K = k_ref（含 cutoff 处并列）
K = base::min(base::length(fg_theta), gt$k_ref)
cutoff = fg_theta[K]
sel = fg_theta >= cutoff
selected_edges = base::paste(tf[sel], tg[sel], sep = "->")
early_precision = base::sum(selected_edges %in% gt$true_edge_set) /
base::length(selected_edges)
early_precision / gt$epr_random_precision
}
